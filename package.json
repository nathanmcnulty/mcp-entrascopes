{
  "name": "mcp-entrascopes",
  "version": "0.1.0",
  "description": "Read-only MCP server for querying Microsoft Entra first-party application scope metadata.",
  "type": "module",
  "bin": {
    "mcp-entrascopes": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "entra",
    "mcp",
    "model-context-protocol",
    "oauth",
    "permissions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanmcnulty/mcp-entrascopes.git"
  },
  "bugs": {
    "url": "https://github.com/nathanmcnulty/mcp-entrascopes/issues"
  },
  "homepage": "https://github.com/nathanmcnulty/mcp-entrascopes#readme",
  "license": "Unlicense",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
